# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Xcode project: generated by XcodeGen from project.yml, never edit or commit
BiteLog.xcodeproj/
# Info.plist is generated too (from project.yml's info: properties)
BiteLog/Info.plist

# Xcode per-user state
xcuserdata/
*.xcuserstate
*.xcscmblueprint
*.xccheckout
IDEWorkspaceChecks.plist
timeline.xctimeline
*.moved-aside

# Build output
build/
DerivedData/
*.hmap
*.ipa
*.xcarchive
*.dSYM
*.dSYM.zip
*.xcresult

# Swift Package Manager (if packages are ever added, keep Package.resolved)
.build/
.swiftpm/
Packages/

# Signing and App Store Connect credentials: never commit
*.p12
*.p8
*.cer
*.certSigningRequest
*.mobileprovision
*.provisionprofile
ExportOptions*.plist
AuthKey_*.p8
.env
.env.*

# Fastlane, if added later
fastlane/report.xml
fastlane/Preview.html
fastlane/screenshots/**/*.png
fastlane/test_output/

# Editors
.idea/
.vscode/
*.swp
*~
